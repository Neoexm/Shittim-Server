<Project>

  <!-- One version for everything that ships. The Control Center carries the same number in its package.json because electron-updater compares that field to decide an update exists, and VersionConsistencyTests fails if the two drift. Bump both together. -->
  <PropertyGroup>
    <Version>2026.7.31</Version>
    <FileVersion>2026.7.31.0</FileVersion>
    <AssemblyVersion>2026.7.31.0</AssemblyVersion>
  </PropertyGroup>

</Project>

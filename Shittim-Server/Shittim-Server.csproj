<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test project asserts on internal helpers (shop reset windows, purchase-count validation). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Shittim-Server.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- >= 15.1.1 for GHSA-rvv3-g6hj-g44x. No separate DI package: AddAutoMapper moved into the
         main package at 13.0. -->
    <PackageReference Include="AutoMapper" Version="15.1.3" />
    <PackageReference Include="ConsoleAppFramework" Version="5.6.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Maintained fork of the abandoned DotNetZip, same Ionic.Zip API. DotNetZip has no fix for
         GHSA-xhg6-9j5j-w4vf (extraction path traversal) and resources are unpacked with ExtractAll. -->
    <PackageReference Include="ProDotNetZip" Version="1.20.0" />
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
    <!-- Servicing release, not the EF 10 RC. Also pulls Microsoft.Build.* out of CVE-2025-55247
         (GHSA-w3q9-fxm7-j8fq), which reaches the graph through Design. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- >= 6.3.0 for GHSA-qrmm-w75w-3wpx (swagger-ui SSRF); 6.x keeps AddSwaggerGen source-compatible. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="6.1.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schale\Schale.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Banner\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\Excel\MultiFloorRaidSeasonManageExcelT.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\Koyuki\koyuki.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\ProhibitedWord\*.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Gateway RSA key pair must survive a clean rebuild. Lose it and the 50001 handshake can no
         longer be decoded against the client's patched global-metadata.dat, and the client hangs
         at "Unpacking game resources". -->
    <None Include="config\GatewayPrivateKey.pem" Link="Config\GatewayPrivateKey.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="config\GatewayPublicKey.pem" Link="Config\GatewayPublicKey.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

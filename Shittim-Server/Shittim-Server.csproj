<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project assert on internal helpers (shop reset windows, purchase-count
         validation) without widening their visibility to the rest of the server. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Shittim-Server.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- 12.0.1 is below the 15.1.1 floor for GHSA-rvv3-g6hj-g44x. The separate DI package is gone
         on purpose: AutoMapper folded AddAutoMapper into the main package at 13.0 and stopped
         shipping the extension, so keeping it would leave two copies of the same extension method. -->
    <PackageReference Include="AutoMapper" Version="15.1.3" />
    <PackageReference Include="ConsoleAppFramework" Version="5.6.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ProDotNetZip is the maintained fork of DotNetZip and keeps the same Ionic.Zip API.
         DotNetZip itself is abandoned and has no fixed release for its extraction path-traversal
         flaw (GHSA-xhg6-9j5j-w4vf), which is directly relevant here: the resource archives are
         unpacked with ZipFile.ExtractAll. The fork is the upgrade path the advisory names. -->
    <PackageReference Include="ProDotNetZip" Version="1.20.0" />
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
    <!-- These were pinned to a release candidate of EF 10 while the data layer this server keeps
         every player's account in ran on it. 10.0.10 is the current servicing release of the same
         major, and it is also what drags Microsoft.Build.* up out of the range covered by
         CVE-2025-55247 (GHSA-w3q9-fxm7-j8fq), which reached the graph through Design. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- 6.0.0 shipped a swagger-ui with an SSRF flaw (GHSA-qrmm-w75w-3wpx, fixed in 6.3.0).
         Staying on the 6.x line keeps AddSwaggerGen/UseSwaggerUI source-compatible. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="6.1.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Schale\Schale.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Excel\MultiFloorRaidSeasonManageExcelT.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the gateway RSA key pair in the runtime Config dir even across a clean rebuild
         (deleting bin/obj). Without this, a clean rebuild loses the keys that the client's
         patched global-metadata.dat expects, so the gateway crypto handshake (50001) can't be
         decoded and the client hangs at "Unpacking game resources". -->
    <None Include="config\GatewayPrivateKey.pem" Link="Config\GatewayPrivateKey.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="config\GatewayPublicKey.pem" Link="Config\GatewayPublicKey.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
